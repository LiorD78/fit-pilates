# ────────────────────────────────────────────────
# Images — aggressive caching (1 year, immutable)
# Files have hash or size suffix, so content never changes for a given URL
# ────────────────────────────────────────────────
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Root-level icons (favicon, apple-touch, android-chrome, opengraph)
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/favicon-*.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/android-chrome-*.png
  Cache-Control: public, max-age=31536000, immutable

/opengraph-image.*
  Cache-Control: public, max-age=31536000, immutable

# ────────────────────────────────────────────────
# CSS — versioned via hash in URL eventually, for now 1 day cache
# Content-Type explicit pro jistotu
# ────────────────────────────────────────────────
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css; charset=UTF-8

# ────────────────────────────────────────────────
# JS (nebudeme mít moc, ale pro budoucnost)
# ────────────────────────────────────────────────
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# ────────────────────────────────────────────────
# XML / TXT / JSON metadata
# ────────────────────────────────────────────────
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=UTF-8

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=UTF-8

/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=UTF-8

/humans.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=UTF-8

/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=UTF-8

# ────────────────────────────────────────────────
# Misc verification files — short cache
# ────────────────────────────────────────────────
/*.txt
  Cache-Control: public, max-age=3600

